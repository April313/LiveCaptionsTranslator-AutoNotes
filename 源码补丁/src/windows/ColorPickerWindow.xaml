<Window
    x:Class="LiveCaptionsTranslator.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="自定义字体颜色"
    Width="330"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="拖动滑块选择颜色，或直接输入十六进制色号。" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="R" />
        <Slider x:Name="SliderR" Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"
                Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="TextR" Grid.Row="1" Grid.Column="2" Margin="0,0,0,8"
                   MinWidth="32" TextAlignment="Right" VerticalAlignment="Center" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="G" />
        <Slider x:Name="SliderG" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8"
                Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="TextG" Grid.Row="2" Grid.Column="2" Margin="0,0,0,8"
                   MinWidth="32" TextAlignment="Right" VerticalAlignment="Center" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="B" />
        <Slider x:Name="SliderB" Grid.Row="3" Grid.Column="1" Margin="0,0,8,12"
                Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="Slider_ValueChanged" />
        <TextBlock x:Name="TextB" Grid.Row="3" Grid.Column="2" Margin="0,0,0,12"
                   MinWidth="32" TextAlignment="Right" VerticalAlignment="Center" />

        <Border x:Name="PreviewBorder" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                Height="42" Margin="0,0,0,8" CornerRadius="4"
                BorderBrush="#FF888888" BorderThickness="1"
                Background="#FFFFFFFF" />

        <TextBox x:Name="HexBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                 Margin="0,0,0,12" TextChanged="HexBox_TextChanged" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResetButton" Content="恢复预设" MinWidth="88" Margin="0,0,8,0"
                    Click="Reset_Click" />
            <Button x:Name="CancelButton" Content="取消" MinWidth="72" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="确定" MinWidth="72" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
